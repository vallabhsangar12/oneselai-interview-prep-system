# =============================================
# OneselfAI - Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
POSTGRES_URL=postgresql://postgres:vallabh@localhost:5433/oneself-ai-interview

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/oneself-ai-interview

# JWT Secret for authentication tokens (use a strong random string)
JWT_SECRET=your_jwt_secret_here

# Node environment
NODE_ENV=development

# Upload directory for resume files
UPLOAD_DIR=OA-version-3/uploads/resumes/

# OpenAI API Key (required for AI-powered question generation & evaluation)
OPENAI_API_KEY=sk-your-key-here

# Auth.js secret (optional)
# AUTH_SECRET=your_auth_secret_here
