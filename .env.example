# =============================================
# OneselfAI - Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# PostgreSQL connection string
# For local: postgresql://postgres:postgres@localhost:5432/oneselai
# Change username/password if your local PostgreSQL uses different credentials
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/oneselai

# MongoDB connection string
# For local: mongodb://localhost:27017/oneselai
MONGODB_URI=mongodb://localhost:27017/oneselai

# JWT Secret for authentication tokens (change this to any random string)
JWT_SECRET=local_dev_jwt_secret_key_change_in_production

# Node environment
NODE_ENV=development

# Upload directory for resume files
UPLOAD_DIR=./uploads

# OpenAI API Key (optional - for AI-powered question generation)
# OPENAI_API_KEY=sk-your-key-here
